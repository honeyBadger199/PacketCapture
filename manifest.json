{
  "manifest_version": 3,
  "name": "HAR Capture",
  "version": "1.0.0",
  "description": "Capture all network traffic from any browser tab and export as HAR files.",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "devtools_page": "devtools/devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}